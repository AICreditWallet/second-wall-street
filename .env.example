# Copy to .env.local and fill in. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are visible in the browser — never put secrets in them.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (see docs/SUPABASE_SETUP.md). Leave empty for read-only demo mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (account deletion). Never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 6: Stripe (not used yet) ---
# Use TEST mode keys (sk_test_..., pk_test_...) during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
