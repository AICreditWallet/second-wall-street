# Copy to .env.local and fill in. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are visible in the browser — never put secrets in them.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (see docs/SUPABASE_SETUP.md). Leave empty for read-only demo mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (account deletion). Never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server-only; see docs/STRIPE_SETUP.md). Leave empty to switch payments off. ---
# Use TEST mode keys (sk_test_... or a restricted rk_test_...) until you are ready to take real money.
# Products, prices and the customer portal are created automatically on first use.
STRIPE_SECRET_KEY=
# From the webhook endpoint pointing at https://<your-site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Set to 1 once Stripe Tax is active in the Stripe account. Live payments stay off without it.
STRIPE_AUTOMATIC_TAX=

# --- Seller details shown on legal pages. Live payments stay off without name and address. ---
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_VAT_NUMBER=
